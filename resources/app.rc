#pragma code_page(65001)
#include <windows.h>
101 DIALOGEX 0, 0, 590, 398
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Febius Fortuna"
MENU 200
FONT 9, "Malgun Gothic", 400, 0, 1
BEGIN
    LTEXT "FEBIUS  /  UTILITY SERIES", -1, 12, 9, 400, 12
    LTEXT "Fortuna", 1100, 12, 23, 260, 29
    RTEXT "Powered by Fortuna ORACLE Engine\nAPP 1.3.0", -1, 398, 24, 180, 25
    CONTROL "", -1, "STATIC", SS_ETCHEDHORZ, 12, 58, 566, 1
    GROUPBOX "생성한 번호", -1, 12, 67, 354, 190
    LTEXT "--   --   --   --   --   --", 1101, 24, 84, 330, 37, SS_CENTER | SS_CENTERIMAGE
    EDITTEXT 1102, 24, 129, 330, 90, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "번호 생성", 1003, 24, 229, 76, 19
    PUSHBUTTON "5게임", 1005, 106, 229, 56, 19
    PUSHBUTTON "10게임", 1006, 168, 229, 56, 19
    PUSHBUTTON "복사", 1007, 230, 229, 56, 19
    PUSHBUTTON "저장", 1008, 292, 229, 62, 19
    GROUPBOX "ORACLE 분석", -1, 376, 67, 202, 190
    LTEXT "분석 전 · 균등 무작위 생성", 1103, 388, 84, 178, 25
    EDITTEXT 1104, 388, 115, 178, 104, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "분석 상세", 1009, 388, 229, 85, 19
    PUSHBUTTON "공식 번호 봉인", 1010, 479, 229, 87, 19
    GROUPBOX "회차 데이터", -1, 12, 263, 566, 57
    LTEXT "CSV를 불러오면 오라클 분석을 사용할 수 있습니다.", 1105, 24, 277, 356, 27
    PUSHBUTTON "CSV 불러오기", 1001, 390, 282, 82, 23
    DEFPUSHBUTTON "오라클 분석", 1002, 478, 282, 88, 23
    CONTROL "", 1106, "msctls_progress32", WS_BORDER, 12, 329, 472, 11
    PUSHBUTTON "분석 취소", 1004, 492, 326, 86, 18
    LTEXT "준비되었습니다. 데이터 없이도 번호를 생성할 수 있습니다.", 1107, 12, 349, 566, 14
    CONTROL "", -1, "STATIC", SS_ETCHEDHORZ, 12, 369, 566, 1
    LTEXT "오라클 지수는 내부 분석 지표입니다. 모든 조합의 실제 1등 확률은 1 / 8,145,060으로 같습니다.", -1, 12, 377, 566, 12
END
200 MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "CSV 불러오기...", 1001
        MENUITEM "생성 번호 저장...", 1008
        MENUITEM "분석 보고서 내보내기...", 1011
        MENUITEM "기록 폴더 열기", 1012
        MENUITEM SEPARATOR
        MENUITEM "끝내기", 1013
    END
    POPUP "분석(&A)"
    BEGIN
        MENUITEM "오라클 분석 / 전체 백테스트", 1002
        MENUITEM "정밀 연구 분석", 1019
        MENUITEM "전체 조합 정밀 연구 (장시간)", 1020
        MENUITEM "분석 취소", 1004
        MENUITEM SEPARATOR
        MENUITEM "다음 회차 확률분포 기록", 1021
        MENUITEM "사전 예측 기록 검증", 1022
        MENUITEM "공동 모형 번호 생성 (연구용)", 1023
        MENUITEM "분석 상세", 1009
        MENUITEM "균등 무작위 모드", 1014
    END
    POPUP "생성(&G)"
    BEGIN
        MENUITEM "새 번호 / Recalculate", 1003
        MENUITEM "5게임 생성", 1005
        MENUITEM "10게임 생성", 1006
        MENUITEM "공식 번호 봉인", 1010
    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "사용 설명서", 1015
        MENUITEM "GitHub 릴리스", 1016
        MENUITEM "Fortuna ORACLE Engine 정보", 1018
        MENUITEM "정보", 1017
    END
END
